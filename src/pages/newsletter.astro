---
import Base from '../layouts/Base.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('daily')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="订阅 · AI前沿">
  <div class="w" style="padding:36px 0;max-width:800px">
    <h1>订阅 Newsletter</h1>
    <p class="mut">每个工作日早 8 点送达，5 分钟看完全球 AI。</p>
    <img class="daily-illust" src="/media/hero-home.png" width="1440" height="480" alt="" />
    <SubscribeBox />
    <div class="card" style="margin-top:24px">
      <h3 style="margin-top:0">订阅后看什么？</h3>
      <VideoEmbed provider="bilibili" id="BV1GJ411x7h7" title="示例：Newsletter 介绍（Bilibili）" />
    </div>
    <h2>往期</h2>
    <ul>{posts.map(p=><li><a href={`/daily/${p.id}`}>{p.data.title}</a></li>)}</ul>
  </div>
</Base>
