---
const { title = 'AI前沿', description = '每天 5 分钟，看完全球 AI 最重要的新闻、新工具和测评。', wide = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="AI前沿" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --color-primary: #7C5CFF;
      --color-accent: #22D3EE;
      --color-ad: #A3E635;
      --color-bg: #0B0F1A;
      --color-card: #121829;
      --color-border: #1F2A44;
      --color-text: #E6EAF2;
      --color-muted: #8A94A8;
      --color-ad-bg: #1A1F10;
      --font-sans: 'Inter', 'Noto Sans SC', 'Source Han Sans SC', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      --max-w: 1200px;
      --article-w: 640px;
    }
    * { box-sizing: border-box; }
    html { background: var(--color-bg); }
    body {
      margin: 0;
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: 17px;
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--color-primary); word-break: break-word; }
    a:hover { color: var(--color-accent); }
    h1, h2, h3 { line-height: 1.35; margin: 0.35em 0; font-weight: 800; }
    code, pre { font-family: var(--font-mono); }
    .w { max-width: var(--max-w); margin: 0 auto; padding: 0 32px; }
    .w-narrow { max-width: 860px; margin: 0 auto; padding: 0 32px; }
    site-header, .site-header {
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
      position: sticky; top: 0; z-index: 40;
    }
    .site-header .w {
      display: flex; align-items: center; justify-content: space-between;
      height: 76px; gap: 16px;
    }
    .logo img { display: block; height: 48px; width: auto; }
    .nav-toggle {
      display: none;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      margin-left: auto;
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      cursor: pointer;
      color: var(--color-text);
    }
    .nav-toggle-bar {
      display: block;
      width: 20px;
      height: 2px;
      background: currentColor;
      border-radius: 1px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .site-header.is-nav-open .nav-toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header.is-nav-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .site-header.is-nav-open .nav-toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .site-header nav { display: flex; align-items: center; flex-wrap: nowrap; gap: 0; }
    .site-header nav a {
      margin-left: 22px; color: var(--color-text); text-decoration: none; font-weight: 500; font-size: 15px;
    }
    .site-header nav a:hover { color: var(--color-accent); }
    .btn {
      display: inline-block;
      background: var(--color-primary); color: #fff !important;
      padding: 9px 18px; border-radius: 8px; text-decoration: none !important;
      font-weight: 600; border: none; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.08); color: #fff !important; }
    .mut { color: var(--color-muted); }
    .tag {
      display: inline-block; font-size: 12px; font-weight: 600;
      color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 12%, transparent);
      padding: 2px 10px; border-radius: 99px; margin-right: 6px;
    }
    .card {
      background: var(--color-card); border: 1px solid var(--color-border);
      border-radius: 14px; padding: 22px;
    }
    .card a { text-decoration: none; color: var(--color-text); }
    .card a:hover { color: var(--color-accent); }
    .hero {
      background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 14%, transparent), color-mix(in srgb, var(--color-accent) 10%, transparent));
      border-bottom: 1px solid var(--color-border);
      padding: 56px 0;
    }
    .grid { display: grid; gap: 24px; }
    .layout-2 { grid-template-columns: 2fr 1fr; }
    .layout-daily { grid-template-columns: 200px minmax(0, 1fr) 300px; gap: 40px; }
    @media (max-width: 1100px) {
      .layout-daily { grid-template-columns: minmax(0, 1fr) 280px; }
      .toc-aside { display: none; }
    }
    @media (max-width: 860px) {
      .w { padding: 0 16px; }
      .layout-2, .layout-daily { grid-template-columns: 1fr; }
      .site-header .w {
        position: relative;
        height: auto;
        min-height: 64px;
        flex-wrap: nowrap;
      }
      .logo { flex-shrink: 1; min-width: 0; }
      .logo img { height: 40px; max-width: min(180px, 52vw); }
      .nav-toggle { display: flex; flex-direction: column; }
      .site-header nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
        padding: 8px 16px 16px;
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
        z-index: 50;
      }
      .site-header.is-nav-open nav { display: flex; }
      .site-header nav a {
        margin-left: 0;
        padding: 12px 4px;
        font-size: 16px;
        border-bottom: 1px solid var(--color-border);
      }
      .site-header nav a:last-child { border-bottom: none; }
      .site-header nav a.btn {
        margin-top: 8px;
        text-align: center;
        border-bottom: none;
      }
      .hero { padding: 36px 0; }
    }
    /* Ads */
    .ad {
      border: 1.5px dashed var(--color-ad);
      background: var(--color-ad-bg);
      border-radius: 12px;
      padding: 16px 20px;
      color: var(--color-text);
      position: relative;
      margin: 16px 0;
    }
    .ad-label {
      position: absolute; top: -11px; left: 14px;
      background: var(--color-ad); color: #111;
      font-size: 12px; padding: 1px 8px; border-radius: 4px; font-weight: 700;
    }
    .ad small { color: var(--color-muted); }
    .ad-body { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .ad-placeholder { font-weight: 700; margin-top: 2px; }
    .ad-placeholder a { color: var(--color-accent); }
    .ad--banner { min-height: 90px; display: flex; flex-direction: column; justify-content: center; }
    .ad--sidebar { min-height: 250px; width: 100%; max-width: 300px; }
    .ad--sidebar-sticky { min-height: 600px; width: 100%; max-width: 300px; }
    .ad--sticky { position: sticky; top: 96px; align-self: start; }
    .ad--full { width: 100%; }
    /* Subscribe */
    .subscribe {
      background: var(--color-card); border: 1px solid var(--color-border);
      border-radius: 14px; padding: 22px; margin: 24px 0;
    }
    .subscribe h3 { margin-top: 0; }
    .beehiiv-placeholder {
      border: 1.5px dashed var(--color-primary); border-radius: 8px;
      padding: 14px; color: var(--color-primary); text-align: center; margin-top: 12px;
    }
    .note {
      background: var(--color-card); padding: 8px 12px;
      border-left: 3px solid var(--color-muted); font-size: 0.92em; color: var(--color-muted);
    }
    /* Article prose */
    .prose { max-width: var(--article-w); font-size: 17px; line-height: 1.8; }
    .prose :global(h2), article.daily-body :global(h2), .daily-body :global(h2) {
      font-size: 22px; margin-top: 32px; color: var(--color-text);
    }
    .daily-body :global(h3) { font-size: 18px; margin-top: 24px; }
    .daily-body :global(p) { margin: 0.7em 0; }
    .daily-body :global(blockquote) {
      margin: 16px 0; padding: 10px 16px;
      border-left: 3px solid var(--color-primary);
      background: var(--color-card); color: var(--color-muted); border-radius: 0 8px 8px 0;
    }
    .daily-body :global(a) { color: var(--color-primary); }
    .daily-body :global(ul), .daily-body :global(ol) { padding-left: 1.3em; }
    .tool-row {
      display: flex; gap: 12px; padding: 10px 0;
      border-bottom: 1px solid var(--color-border); align-items: center;
    }
    .tool-row:last-child { border-bottom: none; }
    .tool-icon {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    }
    .site-footer {
      border-top: 1px solid var(--color-border);
      margin-top: 56px; padding: 28px 0;
      color: var(--color-muted); font-size: 14px;
    }
    main.page { min-height: 60vh; }
    .news-card { padding: 18px 22px; }
    .news-card h3 { font-size: 19px; margin: 6px 0; font-weight: 700; }
    a.news-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    a.news-card-link:hover {
      border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 25%, transparent);
    }
    a.news-card-link:hover h3 { color: var(--color-accent); }

    /* Media */
    .hero-banner { width: 100%; display: block; border-radius: 0; border-bottom: 1px solid var(--color-border); }
    .hero-banner img { width: 100%; height: auto; max-height: 480px; object-fit: cover; display: block; }
    .media-thumb { width: 100%; border-radius: 10px; display: block; aspect-ratio: 16/9; object-fit: cover; background: var(--color-card); }
    .news-card .media-thumb { margin-bottom: 12px; }
    .tool-cover { width: 100%; aspect-ratio: 8/5; object-fit: cover; border-radius: 10px 10px 0 0; display: block; }
    .tool-card { padding: 0; overflow: hidden; }
    .tool-card .tool-body { padding: 16px 18px 20px; }
    .daily-illust { width: 100%; max-width: 800px; border-radius: 14px; border: 1px solid var(--color-border); display: block; margin: 16px 0 24px; }
    .video-embed { margin: 24px 0; }
    .video-frame {
      position: relative; width: 100%; aspect-ratio: 16/9;
      background: #070a12; border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden;
    }
    .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .video-poster {
      position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0;
      cursor: pointer; background: #070a12; display: block;
    }
    .video-poster img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.85; }
    .play-btn {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
      filter: drop-shadow(0 8px 24px rgba(124,92,255,.45));
    }
    .video-badge {
      position: absolute; left: 14px; bottom: 14px;
      background: color-mix(in srgb, var(--color-primary) 85%, #000);
      color: #fff; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 6px;
    }
    .video-embed figcaption { margin-top: 8px; font-size: 14px; }
    .toc-aside a { color: var(--color-muted); text-decoration: none; display: block; margin: 6px 0; font-size: 14px; }
    .toc-aside a:hover { color: var(--color-accent); }
    .toc-aside b { color: var(--color-text); }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="w">
      <a class="logo" href="/" aria-label="AI前沿">
        <img src="/logo.svg" width="220" height="48" alt="AI前沿 AI Frontier" />
      </a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="打开导航菜单">
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
      <nav id="site-nav">
        <a href="/daily">日报</a>
        <a href="/tools">工具库</a>
        <a href="/sponsor">赞助</a>
        <a href="/rss.xml">RSS</a>
        <a class="btn" href="/newsletter">免费订阅</a>
      </nav>
    </div>
  </header>
  <main class="page"><slot /></main>
  <footer class="site-footer">
    <div class="w">© 2026 AI前沿 AI Frontier · 所有新闻附原文链接，赞助内容均标注「赞助 / Sponsored」。</div>
  </footer>
  <script is:inline>
    (function () {
      var header = document.querySelector('.site-header');
      var toggle = document.querySelector('.nav-toggle');
      var nav = document.getElementById('site-nav');
      if (!header || !toggle || !nav) return;

      function setOpen(open) {
        header.classList.toggle('is-nav-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      }

      toggle.addEventListener('click', function () {
        setOpen(!header.classList.contains('is-nav-open'));
      });

      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>
</body>
</html>
