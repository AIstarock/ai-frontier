---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
import { getCollection } from 'astro:content';
import { tools } from '../data/tools';
import { highlights } from '../data/highlights';
const posts = (await getCollection('daily')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const latest = posts[0];
const dateStr = latest ? latest.data.date.toISOString().slice(0,10) : '';
const headline = latest ? latest.data.title.replace(/^AI前沿 #\d+｜/, '') : '';
---
<Base>
  <section class="hero-home">
    <img
      class="hero-home__bg"
      src="/media/hero-home.jpg"
      width="1440"
      height="810"
      alt=""
      fetchpriority="high"
    />
    <div class="hero-home__mask" aria-hidden="true"></div>
    <div class="hero-home__inner">
      <div class="hero-home__copy">
        {latest && (
          <>
            <span class="tag">AI前沿 #{String(latest.data.issue).padStart(3, '0')} · 今日日报</span>
            <h1>{headline}</h1>
            <p class="hero-home__hook">每天 5 分钟，看完全球 AI 最重要的新闻、新工具和测评。</p>
            <a class="btn" href={`/daily/${latest.id}`}>阅读今日日报 →</a>
          </>
        )}
      </div>
      <SubscribeBox />
    </div>
  </section>

  <div class="w" style="padding-top:16px">
    <AdSlot name="banner" />
  </div>

  <div class="w grid layout-2" style="margin-top:36px">
    <div class="grid" style="gap:14px">
      <h2>今日要闻</h2>
      {highlights.map((n, i) => (
        <>
          <a
            class="card news-card news-card-link"
            href={latest ? `/daily/${latest.id}#highlight-${i + 1}` : '/daily'}
          >
            <img class="media-thumb" src={n.image} width="640" height="360" alt="" loading="lazy" />
            <span class="tag">{n.tag}</span>
            <span class="mut" style="font-size:13px">{dateStr}</span>
            <h3>{n.title}</h3>
            <div class="mut" style="font-size:14px">{n.summary}</div>
          </a>
          {i === 3 && <AdSlot name="feed" />}
        </>
      ))}
    </div>

    <aside class="grid" style="align-content:start">
      <div class="card">
        <h3 style="margin-top:0">今日工具</h3>
        {tools.slice(0,4).map(t => (
          <div class="tool-row">
            <img class="tool-icon" src={t.cover} width="40" height="40" alt="" style="object-fit:cover" />
            <div>
              <b>{t.name}</b>
              <div class="mut" style="font-size:13px">{t.cat}</div>
            </div>
          </div>
        ))}
        <p style="margin:12px 0 0"><a href="/tools">全部工具 →</a></p>
      </div>
      <AdSlot name="sidebar" />
      <div class="card">
        <h3 style="margin-top:0">热门测评</h3>
        <p class="mut">· 四款国产大模型编码能力横评<br/>· AI 视频生成工具 2026 Q4 对比</p>
      </div>
      {posts.length > 0 && (
        <div class="card">
          <h3 style="margin-top:0">往期日报</h3>
          <ul style="padding-left:1.1em;margin:0">
            {posts.map(p => (
              <li><a href={`/daily/${p.id}`}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
